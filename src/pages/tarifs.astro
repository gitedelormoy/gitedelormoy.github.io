---
import BaseLayout from '../layouts/BaseLayout.astro';

const courts = [
  { label: "Week-end", sublabel: "2 nuits", basse: 390, moyenne: 430, haute: 470 },
  { label: "3 nuits", sublabel: "", basse: 480, moyenne: 530, haute: 580 },
  { label: "4 nuits", sublabel: "", basse: 560, moyenne: 620, haute: 680 },
  { label: "5 nuits", sublabel: "", basse: 630, moyenne: 700, haute: 770 },
  { label: "6 nuits", sublabel: "", basse: 690, moyenne: 770, haute: 850 },
];
---

<BaseLayout
  title="Tarifs — Gîte de l'Ormoy"
  description="Tarifs du Gîte de l'Ormoy selon les saisons et la durée du séjour. Week-end, semaine, vacances scolaires. Draps et ménage inclus."
>
  <!-- Hero -->
  <section class="relative h-[45vh] min-h-[320px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url(https://res.cloudinary.com/dpgmwola2/image/upload/q_auto/f_auto/v1775496821/Gi%CC%82te_de_l_Ormoy_-_Photos_2023-Le_Gi%CC%82te_de_l_Ormoy--14-min_axmqnm.jpg)"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent" />
    </div>
    <div class="relative z-10 h-full flex flex-col justify-end px-8 md:px-16 lg:px-24 pb-12">
      <h1 class="font-heading text-5xl md:text-7xl font-light text-white leading-[0.95]">
        Nos tarifs<br />
        <span class="italic text-white/70">au fil des saisons</span>
      </h1>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-16 px-8 md:px-16 lg:px-24 border-b border-border">
    <div class="max-w-6xl mx-auto flex items-end justify-between flex-wrap gap-6">
      <p class="font-heading text-2xl md:text-3xl font-light text-foreground italic max-w-lg">
        Tarifs pour le gîte entier, 6 personnes maximum.
      </p>
      <p class="font-body text-sm text-foreground/50 max-w-xs leading-relaxed">
        Draps, linge de toilette et ménage final inclus.<br />
        Taxe de séjour : 0,22€ par nuit et par adulte.
      </p>
    </div>
  </section>

  <!-- Saisons + Semaine -->
  <section class="py-20 px-8 md:px-16 lg:px-24">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-3xl md:text-4xl font-light text-foreground mb-12">
        Séjour à la semaine
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-border">
        <!-- Basse -->
        <div class="bg-background p-10">
          <p class="font-body text-xs text-muted-foreground uppercase tracking-widest mb-6">Basse saison</p>
          <p class="font-heading text-6xl font-light text-foreground mb-2">740€</p>
          <p class="font-body text-xs text-foreground/50">la semaine</p>
          <div class="mt-8 pt-6 border-t border-border">
            <p class="font-body text-xs text-foreground/50 leading-relaxed">Restant de l'année</p>
          </div>
        </div>
        <!-- Moyenne -->
        <div class="bg-background p-10">
          <p class="font-body text-xs text-muted-foreground uppercase tracking-widest mb-6">Moyenne saison</p>
          <p class="font-heading text-6xl font-light text-foreground mb-2">840€</p>
          <p class="font-body text-xs text-foreground/50">la semaine</p>
          <div class="mt-8 pt-6 border-t border-border">
            <p class="font-body text-xs text-foreground/50 leading-relaxed">Vacances scolaires Zone B</p>
          </div>
        </div>
        <!-- Haute -->
        <div class="bg-foreground p-10">
          <p class="font-body text-xs text-white/40 uppercase tracking-widest mb-6">Haute saison</p>
          <p class="font-heading text-6xl font-light text-white mb-2">930€</p>
          <p class="font-body text-xs text-white/40">la semaine</p>
          <div class="mt-8 pt-6 border-t border-white/10">
            <p class="font-body text-xs text-white/40 leading-relaxed">Juillet, août, Noël<br />6 nuits minimum</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Courts séjours -->
  <section class="py-20 px-8 md:px-16 lg:px-24 bg-muted/20">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-3xl md:text-4xl font-light text-foreground mb-12">
        Courts séjours
      </h2>

      <!-- Header -->
      <div class="grid grid-cols-4 gap-4 mb-2 px-4">
        <div></div>
        <p class="font-body text-xs text-muted-foreground uppercase tracking-widest text-center">Basse</p>
        <p class="font-body text-xs text-muted-foreground uppercase tracking-widest text-center">Moyenne</p>
        <p class="font-body text-xs text-muted-foreground uppercase tracking-widest text-center">Haute</p>
      </div>

      <!-- Rows -->
      <div class="divide-y divide-border border-t border-b border-border">
        {courts.map((row) => (
          <div class="grid grid-cols-4 gap-4 items-center py-5 px-4">
            <div>
              <p class="font-body text-sm font-medium text-foreground">{row.label}</p>
              {row.sublabel && <p class="font-body text-xs text-muted-foreground mt-0.5">{row.sublabel}</p>}
            </div>
            <p class="font-heading text-2xl font-light text-foreground text-center">{row.basse}€</p>
            <p class="font-heading text-2xl font-light text-foreground text-center">{row.moyenne}€</p>
            <p class="font-heading text-2xl font-light text-foreground text-center">{row.haute}€</p>
          </div>
        ))}
      </div>

      <p class="font-body text-xs text-muted-foreground mt-6">
        * Taxe de séjour non incluse : 0,22€ par nuit et par adulte.
      </p>
    </div>
  </section>

  <!-- Sur mesure -->
  <section class="py-20 px-8 md:px-16 lg:px-24 border-t border-border">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-end">
      <div>
        <h2 class="font-heading text-3xl md:text-4xl font-light text-foreground mb-4">
          Plus de 6 nuits ?
        </h2>
        <p class="font-body text-foreground/50 text-sm leading-relaxed max-w-sm">
          Pour les séjours supérieurs à une semaine, nous vous proposons un tarif sur mesure adapté à vos dates.
        </p>
      </div>
      <div class="flex items-center gap-6">
        <a
          href="/reserver"
          class="px-7 py-3 bg-primary text-primary-foreground font-body font-medium text-sm rounded-full hover:bg-primary/90 transition-all duration-300 tracking-wide"
        >
          Nous contacter
        </a>
        <a
          href="mailto:info@gitedelormoy.fr"
          class="font-body text-foreground/40 text-sm hover:text-foreground transition-colors duration-300 tracking-wide underline underline-offset-4"
        >
          info@gitedelormoy.fr
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-32 px-8 md:px-16 lg:px-24 bg-foreground">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-end">
      <h2 class="font-heading text-5xl md:text-6xl font-light text-white leading-[1.05]">
        Envie de<br />
        <span class="italic text-white/70">réserver ?</span>
      </h2>
      <div class="space-y-8">
        <p class="font-body text-white/50 text-sm leading-relaxed max-w-sm">
          Contactez-nous pour vérifier les disponibilités et confirmer votre séjour.
        </p>
        <div class="flex items-center gap-6">
          <a
            href="/reserver"
            class="px-7 py-3 bg-white text-stone-900 font-body font-medium text-sm rounded-full hover:bg-white/90 transition-all duration-300 tracking-wide"
          >
            Réserver
          </a>
          <a
            href="mailto:info@gitedelormoy.fr"
            class="font-body text-white/40 text-sm hover:text-white transition-colors duration-300 tracking-wide underline underline-offset-4 decoration-white/20 hover:decoration-white/50"
          >
            Nous écrire
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
