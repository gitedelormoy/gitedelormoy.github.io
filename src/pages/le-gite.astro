---
import BaseLayout from '../layouts/BaseLayout.astro';

const rooms = [
  {
    name: "La Chambre Fleurie",
    description: "Chambre spacieuse avec vue sur le jardin, décorée dans des tons apaisants.",
    detail: "Lit 140cm · Télévision",
  },
  {
    name: "La Chambre Bulle",
    description: "Chambre lumineuse et chaleureuse, idéale pour un séjour reposant.",
    detail: "Lit 140cm · Télévision · Accès de plain-pied",
  },
  {
    name: "La Chambre Nature",
    description: "Chambre aux couleurs de la nature, parfaite pour les enfants ou un couple.",
    detail: "2 lits 90cm",
  },
];

const amenities = [
  "Véranda contemporaine",
  "Cuisine entièrement équipée",
  "Climatisation",
  "Canapé-lit 140cm",
  "Salle de bain moderne",
  "Terrasse privée",
  "Jardin clos",
  "Parking gratuit",
  "Plancha",
  "WiFi Fibre haut débit",
  "Draps et serviettes fournis",
  "Ménage inclus",
];
---

<BaseLayout
  title="Le Gîte — Gîte de l'Ormoy"
  description="Découvrez la Maison de Gardien du Château de l'Ormoy : 3 chambres, 6 couchages, véranda contemporaine. Meublé de tourisme 4 étoiles en Sologne."
>
  <!-- Hero -->
  <section class="relative h-[55vh] min-h-[360px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url(https://res.cloudinary.com/dpgmwola2/image/upload/q_auto/f_auto/v1775496824/-min_arzzxi.jpg)"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent" />
    </div>
    <div class="relative z-10 h-full flex flex-col justify-end px-8 md:px-16 lg:px-24 pb-12">
      <h1 class="font-heading text-5xl md:text-7xl font-light text-white leading-[0.95]">
        Le Gîte<br />
        <span class="italic text-white/70">de l'Ormoy</span>
      </h1>
    </div>
  </section>

  <!-- Description -->
  <section class="py-28 md:py-36 px-8 md:px-16 lg:px-24">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-end">
        <div>
          <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl font-light text-foreground leading-[1.05] mb-10">
            Un joyau<br />
            <span class="italic text-primary">préservé</span>
          </h2>
          <a
            href="/reserver"
            class="inline-flex items-center gap-3 font-body text-sm text-foreground/60 hover:text-primary transition-colors duration-300 tracking-wide group"
          >
            <span class="w-8 h-px bg-current transition-all duration-300 group-hover:w-12"></span>
            Réserver un séjour
          </a>
        </div>
        <div class="space-y-5">
          <p class="font-body text-foreground/70 leading-relaxed text-base">
            La Maison de Gardien du Château de l'Ormoy témoigne de l'histoire à travers les âges. Les propriétaires ont métamorphosé cette bâtisse en un gîte au charme indéniable, grâce à une restauration minutieuse.
          </p>
          <p class="font-body text-foreground/60 leading-relaxed text-sm">
            Chaque détail a été soigneusement pensé pour créer un environnement accueillant où le confort moderne se marie avec l'authenticité.
          </p>
        </div>
      </div>

      <!-- Stats -->
     <div class="mt-20 pt-10 border-t border-border grid grid-cols-3 gap-0">
        {[
          { value: '3', label: 'Chambres' },
          { value: '6', label: 'Couchages' },
          { 
            value: (
              <div class="flex gap-1.5 items-center">
                {[...Array(4)].map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 md:w-9 md:h-9 text-primary">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                ))}
              </div>
            ), 
            label: 'Meublé de tourisme' 
          },
        ].map((stat, i) => (
          <div class={`py-6 ${i > 0 ? 'border-l border-border pl-8 md:pl-12' : ''}`}>
            {/* Ajout du flex et d'une hauteur fixe (h-12) pour un alignement parfait */}
            <div class="font-heading text-4xl md:text-5xl font-light text-foreground flex items-center h-12">
              {stat.value}
            </div>
            <p class="font-body text-xs text-muted-foreground mt-2 tracking-wide uppercase">{stat.label}</p>
          </div>
        ))}
      </div>
  </section>

  <!-- Chambres -->
  <section class="py-28 px-8 md:px-16 lg:px-24 bg-muted/20">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl font-light text-foreground mb-16">
        Les chambres
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-border">
        {rooms.map((room) => (
          <div class="bg-background p-8 md:p-10 flex flex-col gap-6">
            <div>
              <h3 class="font-heading text-2xl font-light text-foreground mb-3">{room.name}</h3>
              <p class="font-body text-sm text-foreground/60 leading-relaxed">{room.description}</p>
            </div>
            <p class="font-body text-xs text-muted-foreground tracking-wide uppercase mt-auto">{room.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Équipements -->
  <section class="py-28 px-8 md:px-16 lg:px-24">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-16 flex-wrap gap-6">
        <h2 class="font-heading text-4xl md:text-5xl font-light text-foreground">
          Équipements
        </h2>
        <a
          href="/services"
          class="inline-flex items-center gap-3 font-body text-sm text-foreground/60 hover:text-primary transition-colors duration-300 tracking-wide group"
        >
          <span class="w-8 h-px bg-current transition-all duration-300 group-hover:w-12"></span>
          Tous les services
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-0 border-t border-border">
        {amenities.map((a) => (
          <div class="flex items-center gap-4 py-5 border-b border-border pr-8">
            <span class="w-1 h-1 rounded-full bg-primary/60 shrink-0"></span>
            <span class="font-body text-sm text-foreground/70">{a}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-32 px-8 md:px-16 lg:px-24 bg-foreground">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-end">
      <h2 class="font-heading text-5xl md:text-6xl font-light text-white leading-[1.05]">
        Envie de<br />
        <span class="italic text-white/70">séjourner ici ?</span>
      </h2>
      <div class="space-y-8">
        <p class="font-body text-white/50 text-sm leading-relaxed max-w-sm">
          Contactez-nous pour connaître les disponibilités et organiser votre séjour sur mesure.
        </p>
        <div class="flex items-center gap-6">
          <a
            href="/reserver"
            class="px-7 py-3 bg-white text-stone-900 font-body font-medium text-sm rounded-full hover:bg-white/90 transition-all duration-300 tracking-wide"
          >
            Réserver
          </a>
          <a
            href="mailto:info@gitedelormoy.fr"
            class="font-body text-white/40 text-sm hover:text-white transition-colors duration-300 tracking-wide underline underline-offset-4 decoration-white/20 hover:decoration-white/50"
          >
            Nous écrire
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
