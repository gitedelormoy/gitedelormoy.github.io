---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.jsx';
import CalendrierPublic from '../components/CalendrierPublic.jsx';
---

<BaseLayout
  title="Réserver — Gîte de l'Ormoy"
  description="Réservez votre séjour au Gîte de l'Ormoy. Vérifiez les disponibilités et contactez-nous pour organiser votre escapade en Sologne & Berry."
>
  <!-- Hero -->
  <section class="relative h-[45vh] min-h-[320px] overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url(https://res.cloudinary.com/dpgmwola2/image/upload/q_auto/f_auto/v1775496829/Gi%CC%82te_de_l_Ormoy_-_Photos_2023-Le_Gi%CC%82te_de_l_Ormoy--4-min_ks62ta.jpg)"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent" />
    </div>
    <div class="relative z-10 h-full flex flex-col justify-end px-8 md:px-16 lg:px-24 pb-12">
      <h1 class="font-heading text-5xl md:text-7xl font-light text-white leading-[0.95]">
        Réserver<br />
        <span class="italic text-white/70">votre séjour</span>
      </h1>
    </div>
  </section>

  <!-- Calendrier -->
  <section class="py-20 px-8 md:px-16 lg:px-24 border-b border-border">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12 flex-wrap gap-6">
        <h2 class="font-heading text-3xl md:text-4xl font-light text-foreground">
          Disponibilités
        </h2>
        <p class="font-body text-sm text-muted-foreground max-w-xs">
          Les dates grisées sont déjà réservées. Contactez-nous pour tout séjour de plus de 7 nuits.
        </p>
      </div>
      <CalendrierPublic client:load />
    </div>
  </section>

  <!-- Formulaire + Infos -->
  <section class="py-20 px-8 md:px-16 lg:px-24">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">

        <!-- Info -->
        <div>
          <h2 class="font-heading text-3xl md:text-4xl font-light text-foreground mb-4">
            Demande de réservation
          </h2>
          <p class="font-body text-foreground/50 text-sm leading-relaxed mb-12 max-w-sm">
            Remplissez le formulaire et nous vous répondrons sous 24-48h pour confirmer les disponibilités.
          </p>

          <div class="divide-y divide-border">
            <div class="py-5">
              <p class="font-body text-xs text-muted-foreground uppercase tracking-widest mb-1">Adresse</p>
              <p class="font-body text-sm text-foreground">
                1 Route de Mehun, 18330 Saint Laurent
              </p>
              <p class="font-body text-sm text-foreground/60">près de Vierzon, France</p>
            </div>
            <div class="py-5">
              <p class="font-body text-xs text-muted-foreground uppercase tracking-widest mb-1">Téléphone</p>
              <a href="tel:+33675512979" class="font-body text-sm text-foreground hover:text-primary transition-colors">
                +33 6 75 51 29 79
              </a>
            </div>
            <div class="py-5">
              <p class="font-body text-xs text-muted-foreground uppercase tracking-widest mb-1">Email</p>
              <a href="mailto:info@gitedelormoy.fr" class="font-body text-sm text-primary hover:underline">
                info@gitedelormoy.fr
              </a>
            </div>
            <div class="py-5">
              <p class="font-body text-xs text-muted-foreground uppercase tracking-widest mb-1">Réponse</p>
              <p class="font-body text-sm text-foreground">Sous 24-48h</p>
            </div>
          </div>

          <!-- Carte -->
          <div class="mt-10 overflow-hidden border border-border h-56">
            <iframe
              title="Localisation Gîte de l'Ormoy"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2709.7689113947526!2d2.2031995121903676!3d47.221103771036844!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47fac445a1d35b31%3A0xc91225407655d81f!2sLe%20G%C3%AEte%20de%20l'Ormoy!5e0!3m2!1sfr!2sfr!4v1776966632505!5m2!1sfr!2sfr"
              class="w-full h-full"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

        <!-- Formulaire -->
        <div>
          <ContactForm client:load />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
