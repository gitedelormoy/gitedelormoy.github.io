---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalerieGrid from '../components/GalerieGrid.jsx';
---

<BaseLayout
  title="Galerie — Gîte de l'Ormoy"
  description="Découvrez en images le Gîte de l'Ormoy : chambres, véranda, jardin et espaces extérieurs de ce meublé de tourisme 4 étoiles en Sologne."
>
  <!-- Hero -->
  <section class="relative h-[55vh] min-h-[360px] overflow-hidden">
    <!-- Vraie balise image pour le SEO local -->
    <img
      src="https://res.cloudinary.com/dpgmwola2/image/upload/q_auto/f_auto/v1775496846/Extrtiot_gjxge4.png"
      alt="Extérieur du Gîte de l'Ormoy, maison de caractère avec grand jardin près de Vierzon et Bourges"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent" />
    
    <div class="relative z-10 h-full flex flex-col justify-end px-8 md:px-16 lg:px-24 pb-12">
      <h1 class="font-heading text-5xl md:text-7xl font-light text-white leading-[0.95]">
        Galerie<br />
        <span class="italic text-white/70">de l'Ormoy</span>
      </h1>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-16 px-8 md:px-16 lg:px-24 border-b border-border">
    <div class="max-w-6xl mx-auto flex items-end justify-between flex-wrap gap-6">
      <p class="font-heading text-2xl md:text-3xl font-light text-foreground italic max-w-lg">
        Chaque espace a été pensé pour allier authenticité et confort moderne.
      </p>
      <span class="font-body text-xs text-muted-foreground tracking-widest uppercase">17 photos</span>
    </div>
  </section>

  <!-- Gallery -->
  <section class="py-12 px-4 md:px-8 lg:px-12">
    <GalerieGrid client:load />
  </section>

  <!-- CTA -->
  <section class="py-32 px-8 md:px-16 lg:px-24 bg-foreground">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-end">
      <h2 class="font-heading text-5xl md:text-6xl font-light text-white leading-[1.05]">
        Envie de vivre<br />
        <span class="italic text-white/70">cette expérience ?</span>
      </h2>
      <div class="space-y-8">
        <p class="font-body text-white/50 text-sm leading-relaxed max-w-sm">
          Réservez votre séjour et profitez de ce cadre d'exception en Sologne.
        </p>
        <div class="flex items-center gap-6">
          <a
            href="/reserver"
            class="px-7 py-3 bg-white text-stone-900 font-body font-medium text-sm rounded-full hover:bg-white/90 transition-all duration-300 tracking-wide"
          >
            Réserver
          </a>
          <a
            href="mailto:info@gitedelormoy.fr"
            class="font-body text-white/40 text-sm hover:text-white transition-colors duration-300 tracking-wide underline underline-offset-4 decoration-white/20 hover:decoration-white/50"
          >
            Nous écrire
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
